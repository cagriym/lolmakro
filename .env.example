LOL_BRIDGE_PUBLIC_URL=https://lolmakro.cagriyildirim.com.tr
LOL_BRIDGE_REQUIRE_NAMED_TUNNEL=1

# Next.js site URL (Vercel deploy - handles QR pairing + mobile API)
