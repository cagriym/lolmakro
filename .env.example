# Site URL (Vercel - always online)
NEXT_PUBLIC_SITE_URL=https://lolmakro.cagriyildirim.com.tr

# API subdomain (Cloudflare Tunnel → localhost:8765)
# Her PC kendi tunnel'ini acar veya public URL manuel verilir
LOL_BRIDGE_PUBLIC_URL=https://api.lolmakro.cagriyildirim.com.tr

# Cloudflare named tunnel (opsiyonel - yoksa quick tunnel kullanir)
# LOL_BRIDGE_TUNNEL_NAME=lolmakro-api

# Cloudflared binary path (opsiyonel)
# LOL_BRIDGE_CLOUDFLARED_PATH=C:\cloudflared.exe
